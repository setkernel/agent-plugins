#!/usr/bin/env python3
"""Apply setkernel's org version holds (policy/versions.json) to a repo's Dependabot config.

  bin/dependabot-policy [--check] [--policy FILE] [REPO_DIR]
      Write (or, with --check, only compare) a generated block at the top of the `ignore:` list
      of every `updates` entry whose ecosystem has holds. The repo's own ignore entries stay
      below the block. Idempotent; a lifted hold disappears on the next run.
      Exit 0: current (or written). 1: stale (--check; the diff is printed). 2: error.

  bin/dependabot-policy crosses [--policy FILE] ECOSYSTEM DEPENDENCY VERSION
      Exit 0 and print the hold id when VERSION of DEPENDENCY crosses a hold, else exit 1.
      Only '>=X[.Y[.Z]]' constraints are evaluated (the form policy/versions.json uses).

Python 3 standard library only, so it runs on the agent VMs and the runners. The YAML edit is
line-based and expects block style (`ignore:` followed by `- dependency-name:` items), which
every setkernel dependabot.yml uses; anything else stops with an error instead of guessing.
"""
import difflib
import fnmatch
import json
import os
import re
import sys

START = "# >>> setkernel version holds (generated by setkernel/agent-plugins bin/dependabot-policy; don't edit)"
END = "# <<< setkernel version holds"
POLICY_URL = "https://github.com/setkernel/agent-plugins/blob/main/policy/versions.json"
DEFAULT_POLICY = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "policy", "versions.json")


def die(msg):
    print(f"dependabot-policy: {msg}", file=sys.stderr)
    sys.exit(2)


def load_policy(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)["holds"]
    except (OSError, ValueError, KeyError) as e:
        die(f"cannot read policy {path}: {e}")


def entries_for(holds, ecosystem):
    """The ignore entries for one ecosystem, each tagged with its hold id."""
    out = []
    for h in holds:
        for e in h.get("dependabot", {}).get(ecosystem, []):
            out.append((h["id"], e))
    return out


def quote(value, style):
    """A YAML scalar in the file's quote style, so formatters such as Prettier leave it alone."""
    if style == "'" and "'" not in value:
        return "'" + value + "'"
    return json.dumps(value)


def render_block(holds, ecosystem, indent, style='"'):
    items = entries_for(holds, ecosystem)
    if not items:
        return []
    pad = " " * indent
    lines = [pad + START, pad + "#     " + POLICY_URL]
    for hold_id, e in items:
        lines.append(f"{pad}- dependency-name: {quote(e['dependency-name'], style)} # {hold_id}")
        for key in ("versions", "update-types"):
            if key in e:
                lines.append(f"{pad}  {key}: [" + ", ".join(quote(v, style) for v in e[key]) + "]")
    lines.append(pad + END)
    return lines


def quote_style(lines):
    """The quote style to write in: the existing generated block's (a formatter may have rewritten
    it), else the one the rest of the file uses most, else double quotes."""
    inside = False
    for line in lines:
        t = line.strip()
        if t.startswith(START[:30]):
            inside = True
        elif t == END:
            inside = False
        elif inside and t.startswith("- dependency-name:"):
            return "'" if "dependency-name: '" in t else '"'
    single = sum(len(re.findall(r"(?:^|[\s\[,:])'", l)) for l in lines if not l.lstrip().startswith("#"))
    double = sum(len(re.findall(r'(?:^|[\s\[,:])"', l)) for l in lines if not l.lstrip().startswith("#"))
    return "'" if single > double else '"'


def indent_of(line):
    return len(line) - len(line.lstrip(" "))


def is_blank(line):
    return not line.strip()


def strip_blocks(lines):
    out, skipping = [], False
    for line in lines:
        s = line.strip()
        if s.startswith(START[:30]):
            skipping = True
            continue
        if skipping:
            if s == END:
                skipping = False
            continue
        out.append(line)
    if skipping:
        die("unterminated generated block (missing the end marker)")
    return out


ECO_RE = re.compile(r"^(\s*)- package-ecosystem:\s*[\"']?([A-Za-z0-9_-]+)[\"']?\s*(#.*)?$")


def entries(lines):
    """(start, end, ecosystem, item_indent) for each `updates` entry; end is exclusive."""
    found = []
    for i, line in enumerate(lines):
        m = ECO_RE.match(line)
        if m:
            found.append((i, len(m.group(1)), m.group(2)))
    declared = sum(1 for line in lines if re.match(r"^\s*-?\s*package-ecosystem:", line))
    if declared != len(found):
        die("every `updates` entry must start with `- package-ecosystem:`; edit by hand")
    result = []
    for n, (start, ind, eco) in enumerate(found):
        stop = found[n + 1][0] if n + 1 < len(found) else len(lines)
        end = start + 1
        while end < stop and (is_blank(lines[end]) or indent_of(lines[end]) > ind):
            end += 1
        result.append((start, end, eco, ind))
    return result


def drop_empty_ignores(lines):
    """Remove an `ignore:` key left with no items (its only items were a lifted block)."""
    out = []
    i = 0
    while i < len(lines):
        line = lines[i]
        if line.strip() == "ignore:":
            ind = indent_of(line)
            j = i + 1
            has_item = False
            while j < len(lines) and (is_blank(lines[j]) or indent_of(lines[j]) > ind
                                      or (indent_of(lines[j]) == ind and lines[j].lstrip().startswith("- "))):
                if lines[j].lstrip().startswith("- "):
                    has_item = True
                    break
                j += 1
            if not has_item:
                i += 1
                continue
        out.append(line)
        i += 1
    return out


def apply(text, holds):
    style = quote_style(text.split("\n"))
    lines = drop_empty_ignores(strip_blocks(text.split("\n")))
    # Work bottom-up so earlier indices stay valid.
    for start, end, eco, ind in reversed(entries(lines)):
        key_ind = ind + 2
        ignore_at = None
        for k in range(start + 1, end):
            line = lines[k]
            if indent_of(line) == key_ind and re.match(r"^\s*ignore:\s*(#.*)?$", line):
                ignore_at = k
                break
            if indent_of(line) == key_ind and re.match(r"^\s*ignore:\s*\S", line):
                die(f"line {k + 1}: flow-style `ignore:` is not supported; use block style")
        if ignore_at is not None:
            item_ind = key_ind + 2
            for k in range(ignore_at + 1, end):
                if not is_blank(lines[k]) and not lines[k].lstrip().startswith("#"):
                    item_ind = indent_of(lines[k])
                    break
            block = render_block(holds, eco, item_ind, style)
            lines[ignore_at + 1:ignore_at + 1] = block
        else:
            block = render_block(holds, eco, key_ind + 2, style)
            if not block:
                continue
            last = end - 1
            while last > start and is_blank(lines[last]):
                last -= 1
            lines[last + 1:last + 1] = [" " * key_ind + "ignore:"] + block
    return "\n".join(lines)


def version_tuple(v):
    parts = re.findall(r"\d+", v)
    return tuple(int(p) for p in parts[:3]) + (0,) * (3 - len(parts[:3]))


def crosses(holds, ecosystem, dependency, version):
    for hold_id, e in entries_for(holds, ecosystem):
        if not fnmatch.fnmatchcase(dependency, e["dependency-name"]):
            continue
        for c in e.get("versions", []):
            m = re.fullmatch(r"\s*>=\s*v?(\d+(?:\.\d+){0,2})\s*", c)
            if m and version_tuple(version) >= version_tuple(m.group(1)):
                return hold_id
    return None


def main(argv):
    policy = DEFAULT_POLICY
    args = list(argv)
    if args and args[0] == "crosses":
        args = args[1:]
        if len(args) >= 2 and args[0] == "--policy":
            policy, args = args[1], args[2:]
        if len(args) != 3:
            die("usage: dependabot-policy crosses [--policy FILE] ECOSYSTEM DEPENDENCY VERSION")
        hold = crosses(load_policy(policy), *args)
        if hold:
            print(hold)
            return 0
        return 1
    check = False
    repo = "."
    while args:
        a = args.pop(0)
        if a == "--check":
            check = True
        elif a == "--policy" and args:
            policy = args.pop(0)
        elif a.startswith("-"):
            die(f"unknown option {a}")
        else:
            repo = a
    holds = load_policy(policy)
    path = None
    for name in ("dependabot.yml", "dependabot.yaml"):
        p = os.path.join(repo, ".github", name)
        if os.path.isfile(p):
            path = p
            break
    if not path:
        print("no .github/dependabot.yml; nothing to do")
        return 0
    with open(path, encoding="utf-8") as f:
        old = f.read()
    new = apply(old, holds)
    if new == old:
        print(f"current: {path}")
        return 0
    if check:
        print(f"stale: {path} (run bin/dependabot-policy)")
        sys.stdout.writelines(difflib.unified_diff(
            old.splitlines(True), new.splitlines(True), "a/" + path, "b/" + path))
        return 1
    with open(path, "w", encoding="utf-8") as f:
        f.write(new)
    print(f"wrote {path}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
