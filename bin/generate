#!/bin/sh
# Generate everything derived from the org rules and the plugin, from one source each:
#
#   rules/org-rules.md + managed/settings.base.json -> managed/settings.json (claudeMd + the rest)
#   policy/versions.json                            -> plugins/setkernel/policy/holds.md (session context)
#
# Usage: bin/generate           write the files
#        bin/generate --check   write nothing; exit 1 and show a diff if any file is stale
#
# Needs POSIX sh, jq and diff. Run from anywhere.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
mode=${1:-write}
case "$mode" in
  write | --check) ;;
  *) echo "usage: bin/generate [--check]" >&2; exit 2 ;;
esac
command -v jq >/dev/null 2>&1 || { echo "bin/generate: needs jq" >&2; exit 2; }

policy_url=https://github.com/setkernel/agent-plugins/blob/main/policy/versions.json

# (a) The server-managed settings: claudeMd is rules/org-rules.md verbatim (minus the final newline).
# A forceLoginOrgUUID still holding its REPLACE_WITH_ placeholder is left out: pasted, it would lock
# every seat out, while a missing key only leaves the login unforced.
render_settings() {
  jq -n --rawfile md "$root/rules/org-rules.md" --slurpfile base "$root/managed/settings.base.json" \
    '{claudeMd: ($md | sub("\n+$"; ""))} + $base[0]
     | if (.forceLoginOrgUUID // "" | startswith("REPLACE_WITH_")) then del(.forceLoginOrgUUID) else . end'
}

# (b) The org version holds, printed into every Claude session by the plugin's SessionStart hook.
render_holds() {
  jq -r --arg url "$policy_url" '
    "# Version holds (setkernel org policy)",
    "",
    "Source: \($url). Never raise a held dependency past its hold anywhere: package.json and lockfiles, `.nvmrc`, `engines`, `actions/setup-node`, Docker images, the runner image. A Dependabot PR that crosses a hold gets closed with a comment naming the hold. A hold changes only when Raghav updates the source; to propose lifting one, open an issue in setkernel/hq.",
    "",
    (.holds[] | "- **\(.id)**: \(.summary). \(.rule) Why: \(.why) Lifts when: \(.lift)")
  ' "$root/policy/versions.json"
}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT INT TERM
render_settings >"$tmp/settings.json"
render_holds >"$tmp/holds.md"

stale=0
for pair in "settings.json:managed/settings.json" "holds.md:plugins/setkernel/policy/holds.md"; do
  src=$tmp/${pair%%:*}
  dest=${pair#*:}
  if [ "$mode" = --check ]; then
    if ! diff -u "$root/$dest" "$src" >"$tmp/diff" 2>&1; then
      echo "stale: $dest (run bin/generate)"
      cat "$tmp/diff"
      stale=1
    fi
  elif ! cmp -s "$src" "$root/$dest" 2>/dev/null; then
    cat "$src" >"$root/$dest"
    echo "wrote $dest"
  fi
done
[ "$mode" = --check ] && [ "$stale" -eq 0 ] && echo "generated files are current"
# Say so on every run until the placeholder is filled.
if grep -q REPLACE_WITH_ "$root/managed/settings.base.json"; then
  echo "note: managed/settings.base.json still holds a REPLACE_WITH_ placeholder, so managed/settings.json leaves out forceLoginOrgUUID; fill it in and run bin/generate" >&2
fi
exit "$stale"
