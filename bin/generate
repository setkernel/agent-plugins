#!/bin/sh
# Generate everything derived from the org rules and the plugin, from one source each:
#
#   rules/org-rules.md + managed/settings.base.json -> managed/settings.json (claudeMd + the rest)
#   (fixed text below)                              -> rules/agents-pointer.md (kit:core block)
#   pointer block + plugin skill/agent names        -> the generated region of check/check.sh
#
# Usage: bin/generate           write the files
#        bin/generate --check   write nothing; exit 1 and show a diff if any file is stale
#
# Needs POSIX sh, jq and diff. Run from anywhere.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
mode=${1:-write}
case "$mode" in
  write | --check) ;;
  *) echo "usage: bin/generate [--check]" >&2; exit 2 ;;
esac
command -v jq >/dev/null 2>&1 || { echo "bin/generate: needs jq" >&2; exit 2; }

rules_url=https://github.com/setkernel/agent-plugins/blob/main/rules/org-rules.md

# (a) The server-managed settings: claudeMd is rules/org-rules.md verbatim (minus the final newline).
render_settings() {
  jq -n --rawfile md "$root/rules/org-rules.md" --slurpfile base "$root/managed/settings.base.json" \
    '{claudeMd: ($md | sub("\n+$"; ""))} + $base[0]'
}

# (b) The pointer block for the top of every repository's AGENTS.md.
render_pointer() {
  cat <<EOF
<!-- kit:core start -->
**setkernel org rules apply here:** $rules_url
(issue tracking, when to stop, secrets, the end-of-run report). Claude Code also gets them from the
org settings. Everything below this block is specific to this repository. Generated; don't edit it.
<!-- kit:core end -->
EOF
}

# The generated region of check/check.sh: the expected block and the org skill/agent names.
render_check_region() {
  skills="" agents=""
  for d in "$root"/plugins/setkernel/skills/*/; do
    d=${d%/}
    skills="$skills${skills:+ }${d##*/}"
  done
  for f in "$root"/plugins/setkernel/agents/*.md; do
    f=${f##*/}
    agents="$agents${agents:+ }${f%.md}"
  done
  echo "# >>> generated by bin/generate; do not edit by hand"
  # A single-quoted string, not $(cat <<HEREDOC): bash 3.2 (macOS /bin/sh) mis-parses a heredoc
  # inside $( ) when its text holds an apostrophe. Each ' becomes '\'' so any wording is safe.
  printf "POINTER_BLOCK='%s'\n" "$(render_pointer | sed "s/'/'\\\\''/g")"
  echo "ORG_SKILLS=\"$skills\""
  echo "ORG_AGENTS=\"$agents\""
  echo "# <<< generated"
}

render_check() {
  render_check_region >"$tmp/region"
  awk -v region="$tmp/region" '
    /^# >>> generated by bin\/generate/ { while ((getline line < region) > 0) print line; skip = 1; next }
    /^# <<< generated/ { skip = 0; next }
    !skip { print }
  ' "$root/check/check.sh"
}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT INT TERM
render_settings >"$tmp/settings.json"
render_pointer >"$tmp/agents-pointer.md"
render_check >"$tmp/check.sh"

stale=0
for pair in "settings.json:managed/settings.json" "agents-pointer.md:rules/agents-pointer.md" "check.sh:check/check.sh"; do
  src=$tmp/${pair%%:*}
  dest=${pair#*:}
  if [ "$mode" = --check ]; then
    if ! diff -u "$root/$dest" "$src" >"$tmp/diff" 2>&1; then
      echo "stale: $dest (run bin/generate)"
      cat "$tmp/diff"
      stale=1
    fi
  elif ! cmp -s "$src" "$root/$dest" 2>/dev/null; then
    cat "$src" >"$root/$dest"
    echo "wrote $dest"
  fi
done
[ "$mode" = --check ] && [ "$stale" -eq 0 ] && echo "generated files are current"
exit "$stale"
