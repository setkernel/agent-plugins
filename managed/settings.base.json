{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch * -D*)",
      "Bash(git branch --delete*--force*)",
      "Bash(git branch --force*--delete*)",
      "Bash(git branch -d -f*)",
      "Bash(git branch -f -d*)",
      "Bash(git branch -fd*)",
      "Bash(git branch -df*)",
      "Bash(npm publish:*)",
      "Bash(gh release create:*)",
      "Bash(wrangler deploy:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(wrangler d1 migrations apply:*)",
      "Bash(npx wrangler d1 migrations apply:*)",
      "Bash(wrangler d1 execute *--remote*--file*)",
      "Bash(npx wrangler d1 execute *--remote*--file*)",
      "Bash(wrangler d1 execute *--file*--remote*)",
      "Bash(npx wrangler d1 execute *--file*--remote*)",
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./.env.*)",
      "Edit(./.env.*)",
      "Read(./.dev.vars)",
      "Edit(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Edit(./.dev.vars.*)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.p8)",
      "Edit(**/*.p8)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/*.jks)",
      "Edit(**/*.jks)",
      "Read(**/*.keystore)",
      "Edit(**/*.keystore)",
      "Read(**/*.mobileprovision)",
      "Edit(**/*.mobileprovision)",
      "Read(**/id_rsa)",
      "Edit(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Edit(**/id_ed25519)",
      "Read(!.env.example)",
      "Edit(!.env.example)",
      "Read(!.dev.vars.example)",
      "Edit(!.dev.vars.example)"
    ]
  },
  "extraKnownMarketplaces": {
    "setkernel": {
      "source": {
        "source": "github",
        "repo": "setkernel/agent-plugins",
        "ref": "main"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "setkernel@setkernel": true
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://sk-obs01.int.setkernel.net:4318",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000",
    "OTEL_LOGS_EXPORT_INTERVAL": "5000",
    "OTEL_METRICS_INCLUDE_SESSION_ID": "false"
  }
}
